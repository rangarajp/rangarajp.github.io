---
/**
 * Sticky top search that jumps to in-page h2/h3 sections.
 * Place once per article page; targets the nearest article.prose / main article.
 */
---

<div class="section-search" data-section-search hidden>
	<label class="section-search-label" for="section-search-input">Jump to section</label>
	<div class="section-search-field">
		<svg class="section-search-icon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
			<path
				fill="currentColor"
				d="M11.7 10.3a5.5 5.5 0 1 0-1.4 1.4l3.3 3.3a1 1 0 0 0 1.4-1.4l-3.3-3.3ZM6.5 10.5a4 4 0 1 1 0-8 4 4 0 0 1 0 8Z"
			/>
		</svg>
		<input
			id="section-search-input"
			type="search"
			class="section-search-input"
			placeholder="Jump to section…"
			autocomplete="off"
			spellcheck="false"
			aria-autocomplete="list"
			aria-controls="section-search-results"
			aria-expanded="false"
			role="combobox"
		/>
		<kbd class="section-search-hint" data-section-search-hint>/</kbd>
	</div>
	<ul
		id="section-search-results"
		class="section-search-results"
		role="listbox"
		hidden
		aria-label="Matching sections"
	></ul>
</div>

<script>
	function slugify(text, fallback) {
		const slug = text
			.toLowerCase()
			.replace(/[^a-z0-9]+/g, '-')
			.replace(/^-|-$/g, '');
		return slug || fallback;
	}

	function headingLabel(el) {
		const clone = /** @type {HTMLElement} */ (el.cloneNode(true));
		clone.querySelectorAll('.katex').forEach((node) => {
			const ann = node.querySelector('annotation');
			node.replaceWith(document.createTextNode(ann?.textContent || ''));
		});
		return (clone.textContent || '').replace(/\s+/g, ' ').trim();
	}

	function collectHeadings(article) {
		const headings = Array.from(article.querySelectorAll('h2, h3')).filter(
			(heading) =>
				!heading.closest('.article-header') &&
				!heading.closest('.page-nav') &&
				!heading.closest('.hub-chapters') &&
				!heading.closest('[data-section-search]'),
		);

		return headings.map((heading, index) => {
			const el = /** @type {HTMLHeadingElement} */ (heading);
			const title = headingLabel(el) || `Section ${index + 1}`;
			if (!el.id) {
				el.id = slugify(title, `section-${index + 1}`);
			}
			return {
				el,
				id: el.id,
				level: el.tagName === 'H3' ? 3 : 2,
				title,
			};
		});
	}

	function initSectionSearch(root) {
		const article =
			document.querySelector('.concepts-article') ||
			document.querySelector('main article.prose') ||
			document.querySelector('main article');
		if (!article) return;

		const sections = collectHeadings(article);
		if (!sections.length) return;

		root.hidden = false;

		const input = /** @type {HTMLInputElement | null} */ (root.querySelector('.section-search-input'));
		const results = /** @type {HTMLUListElement | null} */ (root.querySelector('.section-search-results'));
		const hint = root.querySelector('[data-section-search-hint]');
		if (!input || !results) return;

		/** @type {typeof sections} */
		let filtered = sections;
		let activeIndex = -1;

		function setExpanded(open) {
			input.setAttribute('aria-expanded', open ? 'true' : 'false');
			results.hidden = !open;
		}

		function render() {
			results.innerHTML = '';
			if (!filtered.length) {
				const empty = document.createElement('li');
				empty.className = 'section-search-empty';
				empty.textContent = 'No matching sections';
				results.appendChild(empty);
				setExpanded(true);
				activeIndex = -1;
				return;
			}

			filtered.forEach((section, index) => {
				const li = document.createElement('li');
				li.setAttribute('role', 'option');
				li.id = `section-search-option-${index}`;
				li.className = `section-search-option level-${section.level}`;
				if (index === activeIndex) {
					li.setAttribute('aria-selected', 'true');
					li.classList.add('is-active');
				}
				li.textContent = section.title;
				li.addEventListener('mousedown', (event) => {
					event.preventDefault();
					jumpTo(section);
				});
				results.appendChild(li);
			});

			input.setAttribute(
				'aria-activedescendant',
				activeIndex >= 0 ? `section-search-option-${activeIndex}` : '',
			);
			setExpanded(true);
		}

		function jumpTo(section) {
			setExpanded(false);
			input.value = '';
			filtered = sections;
			activeIndex = -1;
			input.blur();
			section.el.scrollIntoView({ behavior: 'smooth', block: 'start' });
			history.replaceState(null, '', `#${section.id}`);
		}

		function applyFilter(query) {
			const q = query.trim().toLowerCase();
			filtered = q
				? sections.filter((section) => section.title.toLowerCase().includes(q))
				: sections;
			activeIndex = filtered.length ? 0 : -1;
			render();
		}

		input.addEventListener('focus', () => {
			hint?.setAttribute('hidden', '');
			applyFilter(input.value);
		});

		input.addEventListener('blur', () => {
			hint?.removeAttribute('hidden');
			window.setTimeout(() => setExpanded(false), 120);
		});

		input.addEventListener('input', () => {
			applyFilter(input.value);
		});

		input.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowDown') {
				event.preventDefault();
				if (!filtered.length) return;
				activeIndex = (activeIndex + 1) % filtered.length;
				render();
			} else if (event.key === 'ArrowUp') {
				event.preventDefault();
				if (!filtered.length) return;
				activeIndex = (activeIndex - 1 + filtered.length) % filtered.length;
				render();
			} else if (event.key === 'Enter') {
				event.preventDefault();
				if (activeIndex >= 0 && filtered[activeIndex]) {
					jumpTo(filtered[activeIndex]);
				}
			} else if (event.key === 'Escape') {
				event.preventDefault();
				setExpanded(false);
				input.blur();
			}
		});

		document.addEventListener('keydown', (event) => {
			if (event.key !== '/' || event.metaKey || event.ctrlKey || event.altKey) return;
			const target = /** @type {HTMLElement | null} */ (event.target);
			const tag = target?.tagName;
			if (tag === 'INPUT' || tag === 'TEXTAREA' || target?.isContentEditable) return;
			event.preventDefault();
			input.focus();
			input.select();
		});
	}

	document.querySelectorAll('[data-section-search]').forEach((root) => {
		initSectionSearch(/** @type {HTMLElement} */ (root));
	});
</script>

<style>
	.section-search {
		position: sticky;
		top: 0;
		z-index: 40;
		margin: 0 0 1.25rem;
		padding: 0.65rem 0 0.35rem;
		background: linear-gradient(
			180deg,
			rgba(255, 255, 255, 0.97) 70%,
			rgba(255, 255, 255, 0.85) 100%
		);
		backdrop-filter: blur(6px);
	}

	.section-search-label {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.section-search-field {
		position: relative;
		display: flex;
		align-items: center;
	}

	.section-search-icon {
		position: absolute;
		left: 0.75rem;
		color: rgb(var(--gray));
		pointer-events: none;
	}

	.section-search-input {
		width: 100%;
		font: inherit;
		font-size: 0.92rem;
		line-height: 1.3;
		padding: 0.55rem 2.4rem 0.55rem 2.2rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 6px;
		background: #fff;
		color: rgb(var(--gray-dark));
		outline: none;
	}

	.section-search-input::placeholder {
		color: rgb(var(--gray));
	}

	.section-search-input:focus {
		border-color: var(--accent);
		box-shadow: 0 0 0 3px rgba(35, 55, 255, 0.12);
	}

	.section-search-hint {
		position: absolute;
		right: 0.65rem;
		font: inherit;
		font-size: 0.72rem;
		font-weight: 700;
		line-height: 1;
		padding: 0.2rem 0.35rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 4px;
		color: rgb(var(--gray));
		background: rgba(var(--gray-light), 0.55);
		pointer-events: none;
	}

	.section-search-hint[hidden] {
		display: none;
	}

	.section-search-results {
		list-style: none;
		margin: 0.35rem 0 0;
		padding: 0.35rem 0;
		max-height: min(22rem, 55vh);
		overflow-y: auto;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 6px;
		background: #fff;
		box-shadow: 0 8px 24px rgba(var(--gray), 16%);
	}

	.section-search-results[hidden] {
		display: none;
	}

	.section-search-option {
		padding: 0.45rem 0.85rem;
		font-size: 0.9rem;
		line-height: 1.35;
		color: rgb(var(--gray-dark));
		cursor: pointer;
	}

	.section-search-option.level-3 {
		padding-left: 1.5rem;
		font-size: 0.85rem;
		color: rgb(var(--gray));
	}

	.section-search-option:hover,
	.section-search-option.is-active {
		background: rgba(35, 55, 255, 0.06);
		color: var(--accent);
	}

	.section-search-empty {
		padding: 0.55rem 0.85rem;
		font-size: 0.88rem;
		color: rgb(var(--gray));
	}
</style>
