---
---

<aside class="infv2-toc" data-infv2-toc hidden>
	<p class="infv2-toc-heading">On this page</p>
	<nav aria-label="On this page">
		<ul class="infv2-toc-list" data-infv2-toc-list></ul>
	</nav>
</aside>

<script>
	function slugify(text, fallback) {
		const slug = text
			.toLowerCase()
			.replace(/[^a-z0-9]+/g, '-')
			.replace(/^-|-$/g, '');
		return slug || fallback;
	}

	function headingLabel(el) {
		const clone = /** @type {HTMLElement} */ (el.cloneNode(true));
		clone.querySelectorAll('.katex').forEach((node) => {
			const ann = node.querySelector('annotation');
			node.replaceWith(document.createTextNode(ann?.textContent || ''));
		});
		return (clone.textContent || '').replace(/\s+/g, ' ').trim();
	}

	const rail = document.querySelector('[data-infv2-toc]');
	const list = rail?.querySelector('[data-infv2-toc-list]');
	if (rail && list) {
		const article = document.querySelector('.infv2-article');
		if (article) {
			const headings = Array.from(article.querySelectorAll('h2')).filter(
				(heading) => !heading.closest('.infv2-header') && !heading.closest('.infv2-page-nav'),
			);
			headings.forEach((heading, index) => {
				const el = /** @type {HTMLHeadingElement} */ (heading);
				const title = headingLabel(el) || `Section ${index + 1}`;
				if (!el.id) el.id = slugify(title, `section-${index + 1}`);
				const li = document.createElement('li');
				li.className = el.tagName === 'H3' ? 'toc-h3' : 'toc-h2';
				const a = document.createElement('a');
				a.href = `#${el.id}`;
				a.textContent = title;
				li.appendChild(a);
				list.appendChild(li);
			});
			if (list.children.length) rail.removeAttribute('hidden');
		}
	}
</script>

<style>
	.infv2-toc {
		font-size: 0.82rem;
		line-height: 1.4;
		position: sticky;
		top: 1.25rem;
		max-height: calc(100vh - 2.5rem);
		overflow-y: auto;
		padding: 0.15rem 0 1rem 0.75rem;
		border-left: 1px solid rgb(var(--gray-light));
		align-self: start;
	}

	.infv2-toc-heading {
		margin: 0 0 0.65rem;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: rgb(var(--gray));
	}

	.infv2-toc-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.infv2-toc-list a {
		display: block;
		padding: 0.28rem 0 0.28rem 0.65rem;
		margin-left: -0.75rem;
		color: rgb(var(--gray));
		text-decoration: none;
		border-left: 2px solid transparent;
	}

	.infv2-toc-list a:hover {
		color: var(--accent);
	}

	.infv2-toc-list .toc-h3 a {
		padding-left: 1.25rem;
		font-size: 0.78rem;
	}
</style>
