---
import BaseHead from '../BaseHead.astro';
import Footer from '../Footer.astro';
import Header from '../Header.astro';
import { SITE_TITLE } from '../../consts';
import {
	learnChapters,
	INFERENCE_V2_BASE,
	inferenceV2Path,
	neighbors,
	type NavPage,
} from '../../lib/inference-v2';
import '../../styles/inference-v2.css';
import PageToc from './PageToc.astro';
import Sidebar from './Sidebar.astro';

type Props = {
	title: string;
	description: string;
	slug: string;
	showToc?: boolean;
};

const { title, description, slug, showToc = true } = Astro.props;
const page: NavPage | undefined = learnChapters().find(ch => ch.slug === slug);
const { prev, next } = neighbors(slug);


const crumbs: { href?: string; label: string }[] = [
	{ href: '/concepts', label: 'Concepts' },
	{ href: INFERENCE_V2_BASE, label: 'Illustrated handbook' },
];
if (slug) crumbs.push({ label: title });
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} - ${SITE_TITLE}`} description={description} />
	</head>
	<body>
		<a class="infv2-skip" href="#infv2-content">Skip to content</a>
		<Header />
		<div class="infv2">
			<div class:list={['infv2-shell', showToc ? 'has-toc' : 'no-toc']}>
				<Sidebar currentSlug={slug} />
				<main data-pagefind-body class="infv2-main" id="infv2-content">
					<article class="prose infv2-article">
						<header class="infv2-header">
							<div class="infv2-header-top">
								<nav class="infv2-breadcrumbs" aria-label="Breadcrumb">
									{
										crumbs.map((crumb, index) => (
											<>
												{index > 0 && <span class="infv2-sep">/</span>}
												{crumb.href ? (
													<a href={crumb.href}>{crumb.label}</a>
												) : (
													<span aria-current="page">{crumb.label}</span>
												)}
											</>
										))
									}
								</nav>
								<div class="infv2-tools">
									<a href="/search/" class="infv2-icon-btn">
										Search all
										<kbd>⌘K</kbd>
									</a>
									<button
										type="button"
										class="infv2-icon-btn infv2-contents-btn"
										data-infv2-toggle
										aria-expanded="false"
										aria-controls="infv2-sidebar-panel"
									>
										Contents
									</button>
								</div>
							</div>
       {page && <p class="infv2-eyebrow">Chapter {page.chapter}</p>}
							<h1>{title}</h1>
							<p class="infv2-lede">{description}</p>
						</header>

						{slug === 'learn/gpu-fundamentals' && (
							<section class="infv2-gpu-workbench" aria-labelledby="gpu-workbench-title">
								<h2 id="gpu-workbench-title">Explore the GPU before reading the equations</h2>
								<p>Try five hands-on explanations: how data reaches the workers, why memory traffic matters, how matrices multiply, what weight reuse changes, and how the roofline separates the two performance limits.</p>
								<iframe title="Interactive GPU workbench" src="/inference-fieldbook/gpu-workbench.html" id="gpu-workbench-frame" loading="lazy" style="display:block;width:100%;height:630px;border:1px solid var(--gray-light,#d9dedc);border-radius:14px;background:#fffefa" />
								<p class="infv2-gpu-note">The visual explanations are based on our RTX A3000 lab. The detailed chapter below extends these ideas to modern inference hardware.</p>
							</section>
						)}

						<slot />

						{
							(prev || next) && (
								<nav class="infv2-page-nav" aria-label="Chapter navigation">
									{prev ? (
										<a class="prev" href={inferenceV2Path(prev.slug)}>
											<span class="dir">&larr; Previous</span>
											<span class="title">{prev.title}</span>
										</a>
									) : (
										<span />
									)}
									{next ? (
										<a class="next" href={inferenceV2Path(next.slug)}>
											<span class="dir">Next →</span>
											<span class="title">{next.title}</span>
										</a>
									) : (
										<span />
									)}
								</nav>
							)
						}
					</article>
				</main>
				{showToc && <PageToc />}
			</div>
		</div>
		<Footer />
		<style>
			.infv2-gpu-workbench { margin: 2rem 0 3rem; }
			.infv2-gpu-workbench p { text-align: left; hyphens: none; font-size: 1rem; line-height: 1.7; }
			.infv2-gpu-workbench h2 { font-size: 1.45rem; }
			.infv2-gpu-note { color: var(--gray,#59697b); font-size: .9rem !important; }
		</style>
		<script>
			window.addEventListener('message', (event) => {
				if (event.origin !== window.location.origin || event.data?.type !== 'gpu-lab-height') return;
				const frame = document.getElementById('gpu-workbench-frame');
				if (frame && Number.isFinite(event.data.height)) frame.style.height = Math.max(400, Math.min(1050, event.data.height + 18)) + 'px';
			});

			document.querySelectorAll('.infv2-article pre').forEach((pre) => {
				if (pre.querySelector('.infv2-copy')) return;
				pre.classList.add('infv2-code-wrap');
				const btn = document.createElement('button');
				btn.type = 'button';
				btn.className = 'infv2-copy';
				btn.textContent = 'Copy';
				btn.addEventListener('click', async () => {
					const code = pre.querySelector('code');
					const text = code?.textContent || pre.textContent || '';
					try {
						await navigator.clipboard.writeText(text);
						btn.textContent = 'Copied';
						window.setTimeout(() => {
							btn.textContent = 'Copy';
						}, 1200);
					} catch {
						btn.textContent = 'Copy failed';
					}
				});
				pre.appendChild(btn);
			});
		</script>
	</body>
</html>
