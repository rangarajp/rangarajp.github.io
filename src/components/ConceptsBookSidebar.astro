---
import {
	getConceptPath,
	type ConceptEntry,
	type ConceptSeries,
} from '../lib/concepts';

type Props = {
	allSeries: ConceptSeries[];
	currentSeriesId: string | null;
	currentEntryId: string;
	isHub: boolean;
};

const { allSeries, currentSeriesId, currentEntryId, isHub } = Astro.props;
---

<aside class="book-nav" data-book-sidebar>
	<div class="book-nav-backdrop" data-sidebar-close hidden></div>
	<div id="book-sidebar-panel" class="book-nav-panel">
		<div class="sidebar-toolbar">
			<a class="sidebar-all" href="/concepts">All books</a>
			<button type="button" class="sidebar-close" data-sidebar-close aria-label="Close contents">
				Close
			</button>
		</div>

		<nav aria-label="Book contents">
			{allSeries.map((book) => {
				const isCurrentBook = book.id === currentSeriesId;
				return (
					<details class="book-group" open={isCurrentBook || undefined}>
						<summary class="book-summary">
							<span class="book-title">{book.title}</span>
							<span class="book-count">{book.articles.length}</span>
						</summary>
						<ul class="chapter-list">
							<li class:list={['hub-link', { active: isCurrentBook && isHub }]}>
								<a href={book.hubPath}>Overview</a>
							</li>
							{book.articles.map((article: ConceptEntry, index: number) => {
								const isActive = article.id === currentEntryId;
								return (
									<li class:list={[{ active: isActive }]}>
										<a href={getConceptPath(article.id)}>
											<span class="ch-num">{index + 1}</span>
											<span class="ch-title">{article.data.title}</span>
										</a>
									</li>
								);
							})}
						</ul>
					</details>
				);
			})}
		</nav>
	</div>
</aside>

<script>
	const root = document.querySelector('[data-book-sidebar]');
	const backdrop = root?.querySelector('[data-sidebar-close].book-nav-backdrop, .book-nav-backdrop');
	const closeBtns = root?.querySelectorAll('[data-sidebar-close]');
	const toggles = document.querySelectorAll('[data-sidebar-toggle]');

	function setOpen(open) {
		if (!root) return;
		root.classList.toggle('is-open', open);
		toggles.forEach((toggle) => {
			toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
			toggle.textContent = open ? 'Hide contents' : 'Contents';
		});
		if (backdrop) {
			if (open) backdrop.removeAttribute('hidden');
			else backdrop.setAttribute('hidden', '');
		}
		document.body.classList.toggle('book-nav-open', open);
	}

	toggles.forEach((toggle) => {
		toggle.addEventListener('click', () => {
			setOpen(!root?.classList.contains('is-open'));
		});
	});

	closeBtns?.forEach((btn) => {
		btn.addEventListener('click', () => setOpen(false));
	});

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') setOpen(false);
	});

	// On mobile drawer, close after navigating
	const mq = window.matchMedia('(max-width: 1099px)');
	root?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => {
			if (mq.matches) setOpen(false);
		});
	});
</script>

<style is:global>
	body.book-nav-open {
		overflow: hidden;
	}

	@media (min-width: 1100px) {
		body.book-nav-open {
			overflow: auto;
		}
	}
</style>

<style>
	.book-nav {
		font-size: 0.88rem;
		line-height: 1.4;
		align-self: start;
	}

	.book-nav-backdrop {
		display: none;
	}

	.book-nav-panel {
		position: sticky;
		top: 1.25rem;
		max-height: calc(100vh - 2.5rem);
		overflow-y: auto;
		padding: 0.15rem 0.75rem 1.5rem 0;
		border-right: 1px solid rgb(var(--gray-light));
	}

	.sidebar-toolbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin-bottom: 0.85rem;
	}

	.sidebar-all {
		font-size: 0.8rem;
		font-weight: 600;
		color: rgb(var(--gray));
		text-decoration: none;
	}

	.sidebar-all:hover {
		color: var(--accent);
	}

	.sidebar-close {
		display: none;
		font: inherit;
		font-size: 0.8rem;
		font-weight: 600;
		padding: 0.3rem 0.55rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 4px;
		background: #fff;
		color: rgb(var(--gray));
		cursor: pointer;
	}

	.sidebar-close:hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	.book-group {
		border: none;
		border-radius: 0;
		margin-bottom: 0.35rem;
		background: transparent;
		overflow: visible;
	}

	.book-summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 0.45rem 0.35rem;
		cursor: pointer;
		list-style: none;
		font-weight: 600;
		font-size: 0.86rem;
		color: rgb(var(--black));
		user-select: none;
	}

	.book-summary::-webkit-details-marker {
		display: none;
	}

	.book-summary::before {
		content: '▸';
		display: inline-block;
		margin-right: 0.35rem;
		color: rgb(var(--gray));
		font-size: 0.7rem;
		transition: transform 0.15s ease;
	}

	.book-group[open] > .book-summary::before {
		transform: rotate(90deg);
	}

	.book-title {
		flex: 1;
		min-width: 0;
	}

	.book-count {
		flex-shrink: 0;
		font-size: 0.7rem;
		font-weight: 600;
		color: rgb(var(--gray));
		background: rgba(var(--gray-light), 0.8);
		border-radius: 999px;
		min-width: 1.3rem;
		height: 1.3rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0 0.3rem;
	}

	.chapter-list {
		list-style: none;
		margin: 0 0 0.4rem;
		padding: 0 0 0.25rem 0.15rem;
	}

	.chapter-list > li > a {
		display: flex;
		align-items: flex-start;
		gap: 0.4rem;
		padding: 0.32rem 0.45rem;
		border-radius: 4px;
		text-decoration: none;
		color: rgb(var(--gray-dark));
	}

	.chapter-list > li > a:hover {
		background: rgba(var(--gray-light), 0.55);
		color: var(--accent);
	}

	.chapter-list > li.active > a {
		background: rgba(35, 55, 255, 0.08);
		color: var(--accent);
		font-weight: 600;
	}

	.hub-link > a {
		font-style: italic;
		color: rgb(var(--gray));
	}

	.ch-num {
		flex-shrink: 0;
		width: 1.1rem;
		font-size: 0.72rem;
		font-weight: 600;
		color: rgb(var(--gray));
		text-align: right;
		padding-top: 0.1rem;
	}

	.chapter-list > li.active .ch-num {
		color: var(--accent);
	}

	.ch-title {
		flex: 1;
		min-width: 0;
	}

	@media (max-width: 1099px) {
		.book-nav-backdrop {
			display: block;
			position: fixed;
			inset: 0;
			z-index: 49;
			background: rgba(15, 18, 25, 0.28);
		}

		.book-nav-backdrop[hidden] {
			display: none !important;
		}

		.book-nav-panel {
			position: fixed;
			top: 0;
			left: 0;
			bottom: 0;
			z-index: 50;
			width: min(20rem, calc(100% - 2rem));
			max-height: none;
			padding: 1rem 0.85rem 1.5rem;
			background: #fff;
			border-right: 1px solid rgb(var(--gray-light));
			box-shadow: 8px 0 24px rgba(var(--gray), 12%);
			transform: translateX(-105%);
			transition: transform 0.2s ease;
		}

		.book-nav.is-open .book-nav-panel {
			transform: translateX(0);
		}

		.sidebar-close {
			display: inline-block;
		}
	}
</style>
