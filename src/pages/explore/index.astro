import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Explore - ${SITE_TITLE}`} description="Experiments and open-ended investigations" />
	</head>
	<body>
		<Header />
		<main>
			<h1>Explore</h1>
			<p>Experiments and open-ended investigations.</p>
			<p class="empty">Nothing here yet.</p>
		</main>
		<Footer />
	</body>
</html>

<style>
	.empty {
		color: rgb(var(--gray));
		font-style: italic;
	}
</style>
