---
import BaseHead from '../../components/BaseHead.astro';
import ConceptsBookSidebar from '../../components/ConceptsBookSidebar.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { getCollection, render } from 'astro:content';
import {
	getConceptPath,
	getSeriesContext,
	groupConceptsBySeries,
	isSeriesHub,
} from '../../lib/concepts';

export async function getStaticPaths() {
	const concepts = await getCollection('concepts');

	return concepts.map((entry) => {
		const slug = entry.id.endsWith('/index') ? entry.id.slice(0, -'/index'.length) : entry.id;
		return {
			params: { slug },
			props: { entry },
		};
	});
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const concepts = await getCollection('concepts');
const { series: allSeries } = groupConceptsBySeries(concepts);
const seriesContext = getSeriesContext(entry, concepts);
const isHub = isSeriesHub(entry.id);

const backHref = seriesContext && !isHub ? seriesContext.series.hubPath : '/concepts';
const backLabel = seriesContext && !isHub ? seriesContext.series.title : 'All books';

const articles = seriesContext?.series.articles ?? [];
const currentIndex = seriesContext?.currentIndex ?? -1;
const firstChapter = articles[0];
const prevArticle = currentIndex > 0 ? articles[currentIndex - 1] : null;
const nextArticle =
	currentIndex >= 0 && currentIndex < articles.length - 1 ? articles[currentIndex + 1] : null;
const isFirstChapter = currentIndex === 0;
const isLastChapter = currentIndex >= 0 && currentIndex === articles.length - 1;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${entry.data.title} - ${SITE_TITLE}`} description={entry.data.description} />
	</head>
	<body>
		<Header />
		{seriesContext && (
			<ConceptsBookSidebar
				allSeries={allSeries}
				currentSeriesId={seriesContext.series.id}
				currentEntryId={entry.id}
				isHub={isHub}
			/>
		)}
		<main class:list={['concepts-shell', { 'is-hub': isHub }]}>
			<article class:list={['prose', 'concepts-article', { 'hub-article': isHub }]}>
				<header class="article-header">
					<div class="header-top">
						<nav class="breadcrumbs" aria-label="Breadcrumb">
							<a href="/concepts">Concepts</a>
							{seriesContext && (
								<>
									<span class="separator">/</span>
									{isHub ? (
										<span aria-current="page">{seriesContext.series.title}</span>
									) : (
										<a href={seriesContext.series.hubPath}>{seriesContext.series.title}</a>
									)}
								</>
							)}
							{seriesContext && !isHub && (
								<>
									<span class="separator">/</span>
									<span aria-current="page">{entry.data.title}</span>
								</>
							)}
							{!seriesContext && (
								<>
									<span class="separator">/</span>
									<span aria-current="page">{entry.data.title}</span>
								</>
							)}
						</nav>
						{seriesContext && (
							<button
								type="button"
								class="contents-btn"
								data-sidebar-toggle
								aria-expanded="false"
								aria-controls="book-sidebar-panel"
							>
								Contents
							</button>
						)}
					</div>
					<a href={backHref} class="back-link">&larr; {backLabel}</a>
					{seriesContext && !isHub && currentIndex >= 0 && (
						<p class="chapter-eyebrow">Chapter {currentIndex + 1} of {articles.length}</p>
					)}
					<h1>{entry.data.title}</h1>
					<p class="description">{entry.data.description}</p>
				</header>

				{isHub && seriesContext ? (
					<>
						<section class="hub-chapters" aria-label="Chapters">
							<h2 class="hub-chapters-title">Chapters</h2>
							<ol class="hub-chapter-list">
								{articles.map((article) => (
									<li>
										<a href={getConceptPath(article.id)}>
											<span class="hub-chapter-title">{article.data.title}</span>
											{article.data.description && (
												<span class="hub-chapter-desc">{article.data.description}</span>
											)}
										</a>
									</li>
								))}
							</ol>
							{firstChapter && (
								<p class="start-reading">
									<a href={getConceptPath(firstChapter.id)}>
										Start with Chapter 1 — {firstChapter.data.title} →
									</a>
								</p>
							)}
						</section>

						<div class="hub-more">
							<Content />
						</div>
					</>
				) : (
					<Content />
				)}

				{seriesContext && !isHub && currentIndex >= 0 && (
					<nav class="page-nav" aria-label="Chapter navigation">
						{isFirstChapter ? (
							<a class="page-nav-link prev" href={seriesContext.series.hubPath}>
								<span class="page-nav-direction">&larr; Contents</span>
								<span class="page-nav-title">{seriesContext.series.title}</span>
							</a>
						) : prevArticle ? (
							<a class="page-nav-link prev" href={getConceptPath(prevArticle.id)}>
								<span class="page-nav-direction">&larr; Chapter {currentIndex}</span>
								<span class="page-nav-title">{prevArticle.data.title}</span>
							</a>
						) : (
							<span />
						)}
						{nextArticle ? (
							<a class="page-nav-link next" href={getConceptPath(nextArticle.id)}>
								<span class="page-nav-direction">Chapter {currentIndex + 2} →</span>
								<span class="page-nav-title">{nextArticle.data.title}</span>
							</a>
						) : isLastChapter ? (
							<a class="page-nav-link next" href={seriesContext.series.hubPath}>
								<span class="page-nav-direction">End of book →</span>
								<span class="page-nav-title">Back to contents</span>
							</a>
						) : (
							<span />
						)}
					</nav>
				)}
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	main.concepts-shell {
		width: min(46rem, calc(100% - 2em));
		max-width: none;
		margin-left: auto;
		margin-right: auto;
	}

	main.concepts-shell.is-hub {
		width: min(58rem, calc(100% - 2em));
	}

	.concepts-article {
		min-width: 0;
	}

	.article-header {
		margin-bottom: 1.5rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid rgb(var(--gray-light));
	}

	.header-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.75rem;
	}

	.contents-btn {
		flex-shrink: 0;
		font: inherit;
		font-size: 0.82rem;
		font-weight: 700;
		padding: 0.35rem 0.7rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 999px;
		background: #fff;
		color: rgb(var(--gray-dark));
		cursor: pointer;
	}

	.contents-btn:hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	.breadcrumbs {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.35rem;
		margin-bottom: 0;
		font-size: 0.85rem;
		color: rgb(var(--gray));
	}

	.breadcrumbs a {
		color: rgb(var(--gray));
		text-decoration: none;
	}

	.breadcrumbs a:hover {
		color: var(--accent);
	}

	.separator {
		color: rgb(var(--gray-light));
	}

	.back-link {
		display: inline-block;
		margin-bottom: 0.75rem;
		font-size: 0.9rem;
		color: rgb(var(--gray));
		text-decoration: none;
	}

	.back-link:hover {
		color: var(--accent);
	}

	.chapter-eyebrow {
		margin: 0 0 0.35rem;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: rgb(var(--gray));
	}

	.article-header h1 {
		font-size: 1.85rem;
		font-weight: 700;
		letter-spacing: -0.015em;
		line-height: 1.25;
		margin-bottom: 0.5rem;
	}

	.description {
		font-size: 1.05rem;
		line-height: 1.5;
		color: rgb(var(--gray));
		margin: 0;
	}

	.hub-chapters {
		margin-top: 0.5rem;
	}

	.hub-chapters-title {
		font-size: 1.2rem;
		margin: 0 0 0.85rem;
	}

	.hub-chapter-list {
		list-style: none;
		padding: 0;
		margin: 0;
		counter-reset: chapter;
	}

	.hub-chapter-list li {
		counter-increment: chapter;
		margin: 0 0 0.85rem;
		padding: 0;
	}

	.hub-chapter-list a {
		display: grid;
		grid-template-columns: 2rem 1fr;
		column-gap: 0.65rem;
		row-gap: 0.15rem;
		text-decoration: none;
		color: inherit;
		padding: 0.75rem 0.9rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 6px;
		background: #fff;
	}

	.hub-chapter-list a::before {
		content: counter(chapter) '.';
		grid-row: 1 / span 2;
		font-weight: 700;
		color: rgb(var(--gray));
		padding-top: 0.1rem;
	}

	.hub-chapter-list a:hover {
		border-color: var(--accent);
	}

	.hub-chapter-title {
		font-weight: 700;
		line-height: 1.35;
	}

	.hub-chapter-desc {
		grid-column: 2;
		font-size: 0.92rem;
		line-height: 1.45;
		color: rgb(var(--gray));
	}

	.hub-more {
		margin-top: 2.25rem;
		padding-top: 1.5rem;
		border-top: 1px solid rgb(var(--gray-light));
	}

	.start-reading {
		margin: 1.5rem 0 0;
		font-size: 0.95rem;
		font-weight: 600;
	}

	.start-reading a {
		text-decoration: none;
	}

	.start-reading a:hover {
		color: var(--accent);
	}

	.page-nav {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 1px solid rgb(var(--gray-light));
	}

	.page-nav-link {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		padding: 1rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 4px;
		text-decoration: none;
		color: inherit;
		transition: border-color 0.2s;
	}

	.page-nav-link:hover {
		border-color: var(--accent);
	}

	.page-nav-link.next {
		text-align: right;
		grid-column: 2;
	}

	.page-nav-direction {
		font-size: 0.85rem;
		color: rgb(var(--gray));
	}

	.page-nav-title {
		font-weight: 700;
	}

	@media (max-width: 640px) {
		.page-nav {
			grid-template-columns: 1fr;
		}
		.page-nav-link.next {
			grid-column: 1;
			text-align: left;
		}
	}
</style>
