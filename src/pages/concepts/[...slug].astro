---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { getCollection, render } from 'astro:content';
import { getConceptPath, getSeriesContext, isSeriesHub } from '../../lib/concepts';

export async function getStaticPaths() {
	const concepts = await getCollection('concepts');

	return concepts.map((entry) => {
		const slug = entry.id.endsWith('/index') ? entry.id.slice(0, -'/index'.length) : entry.id;
		return {
			params: { slug },
			props: { entry },
		};
	});
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const concepts = await getCollection('concepts');
const seriesContext = getSeriesContext(entry, concepts);
const isHub = isSeriesHub(entry.id);

const backHref = seriesContext && !isHub ? seriesContext.series.hubPath : '/concepts';
const backLabel = seriesContext && !isHub ? seriesContext.series.title : 'All Concepts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${entry.data.title} - ${SITE_TITLE}`} description={entry.data.description} />
	</head>
	<body>
		<Header />
		<main>
			<article class="prose">
				<header class="article-header">
					<nav class="breadcrumbs" aria-label="Breadcrumb">
						<a href="/concepts">Concepts</a>
						{seriesContext && (
							<>
								<span class="separator">/</span>
								{isHub ? (
									<span aria-current="page">{seriesContext.series.title}</span>
								) : (
									<a href={seriesContext.series.hubPath}>{seriesContext.series.title}</a>
								)}
							</>
						)}
						{seriesContext && !isHub && (
							<>
								<span class="separator">/</span>
								<span aria-current="page">{entry.data.title}</span>
							</>
						)}
						{!seriesContext && (
							<>
								<span class="separator">/</span>
								<span aria-current="page">{entry.data.title}</span>
							</>
						)}
					</nav>
					<a href={backHref} class="back-link">&larr; {backLabel}</a>
					<h1>{entry.data.title}</h1>
					<p class="description">{entry.data.description}</p>
				</header>

				{seriesContext && (
					<nav class="series-nav" aria-label={`${seriesContext.series.title} topics`}>
						<p class="series-nav-label">In this series</p>
						<ol class="series-nav-list">
							{seriesContext.series.articles.map((article, index) => (
								<li class:list={[{ active: article.id === entry.id }]}>
									<span class="step">{index + 1}</span>
									<a href={getConceptPath(article.id)}>{article.data.title}</a>
								</li>
							))}
						</ol>
					</nav>
				)}

				<Content />

				{seriesContext && !isHub && seriesContext.currentIndex >= 0 && (
					<nav class="page-nav" aria-label="Article navigation">
						{seriesContext.currentIndex > 0 ? (
							<a
								class="page-nav-link prev"
								href={getConceptPath(seriesContext.series.articles[seriesContext.currentIndex - 1].id)}
							>
								<span class="page-nav-direction">&larr; Previous</span>
								<span class="page-nav-title">
									{seriesContext.series.articles[seriesContext.currentIndex - 1].data.title}
								</span>
							</a>
						) : (
							<span />
						)}
						{seriesContext.currentIndex < seriesContext.series.articles.length - 1 ? (
							<a
								class="page-nav-link next"
								href={getConceptPath(seriesContext.series.articles[seriesContext.currentIndex + 1].id)}
							>
								<span class="page-nav-direction">Next &rarr;</span>
								<span class="page-nav-title">
									{seriesContext.series.articles[seriesContext.currentIndex + 1].data.title}
								</span>
							</a>
						) : (
							<span />
						)}
					</nav>
				)}
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.article-header {
		margin-bottom: 2rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.breadcrumbs {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.35rem;
		margin-bottom: 0.75rem;
		font-size: 0.85rem;
		color: rgb(var(--gray));
	}
	.breadcrumbs a {
		color: rgb(var(--gray));
		text-decoration: none;
	}
	.breadcrumbs a:hover {
		color: var(--accent);
	}
	.separator {
		color: rgb(var(--gray-light));
	}
	.back-link {
		display: inline-block;
		margin-bottom: 1rem;
		font-size: 0.9rem;
		color: rgb(var(--gray));
		text-decoration: none;
	}
	.back-link:hover {
		color: var(--accent);
	}
	.article-header h1 {
		font-size: 2.4rem;
		margin-bottom: 0.5rem;
	}
	.description {
		font-size: 1.1rem;
		color: rgb(var(--gray));
		margin: 0;
	}
	.series-nav {
		margin-bottom: 2rem;
		padding: 1rem 1.25rem;
		background: rgba(var(--gray-light), 0.25);
		border-radius: 8px;
	}
	.series-nav-label {
		margin: 0 0 0.75rem;
		font-size: 0.8rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: rgb(var(--gray));
	}
	.series-nav-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.series-nav-list li {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}
	.series-nav-list li.active a {
		color: var(--accent);
		font-weight: 600;
	}
	.step {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.35rem;
		height: 1.35rem;
		border-radius: 999px;
		background: rgb(var(--gray-light));
		font-size: 0.75rem;
		font-weight: 600;
		color: rgb(var(--gray));
	}
	.series-nav-list li.active .step {
		background: var(--accent);
		color: white;
	}
	.series-nav-list a {
		font-size: 0.9rem;
		text-decoration: none;
	}
	.series-nav-list a:hover {
		color: var(--accent);
	}
	.page-nav {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.page-nav-link {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		padding: 1rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		text-decoration: none;
		color: inherit;
		transition: border-color 0.2s;
	}
	.page-nav-link:hover {
		border-color: var(--accent);
	}
	.page-nav-link.next {
		text-align: right;
		grid-column: 2;
	}
	.page-nav-direction {
		font-size: 0.85rem;
		color: rgb(var(--gray));
	}
	.page-nav-title {
		font-weight: 600;
	}
	.prose {
		line-height: 1.8;
	}
	/* Article body: keep section titles smaller than the page h1 */
	.prose :global(h2) {
		font-size: 1.5rem;
		margin-top: 2.5rem;
		margin-bottom: 0.75rem;
		font-weight: 700;
	}
	.prose :global(h3) {
		font-size: 1.2rem;
		margin-top: 1.75rem;
		margin-bottom: 0.5rem;
		font-weight: 600;
	}
	.prose :global(h4) {
		font-size: 1.05rem;
		margin-top: 1.25rem;
		margin-bottom: 0.4rem;
		font-weight: 600;
	}
	.prose :global(ol),
	.prose :global(ul) {
		padding-left: 1.5rem;
	}
	.prose :global(li) {
		margin-bottom: 0.5rem;
	}
	.prose :global(pre) {
		background-color: rgb(var(--gray-dark));
		color: #f8f8f2;
		padding: 1.25rem;
		border-radius: 8px;
		overflow-x: auto;
		font-size: 0.9rem;
		line-height: 1.5;
	}
	.prose :global(img) {
		margin: 1.5rem 0;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
	}
	.prose :global(blockquote) {
		border-left: 4px solid var(--accent);
		padding: 0.5rem 0 0.5rem 1.25rem;
		margin: 1.5rem 0;
		background: rgba(var(--gray-light), 0.3);
		border-radius: 0 4px 4px 0;
	}
	@media (max-width: 640px) {
		.page-nav {
			grid-template-columns: 1fr;
		}
		.page-nav-link.next {
			grid-column: 1;
		}
	}
</style>
