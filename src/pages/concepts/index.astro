---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';
import { getConceptPath, groupConceptsBySeries } from '../../lib/concepts';

const concepts = await getCollection('concepts');
const { series, standalone } = groupConceptsBySeries(concepts);

function noteLabel(count: number): string {
	return count === 1 ? '1 chapter' : `${count} chapters`;
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Concepts - ${SITE_TITLE}`} description="Core ideas and mental models" />
	</head>
	<body>
		<Header />
		<main class="concepts-index">
			<header class="page-intro">
				<h1>Concepts</h1>
				<p>Short books on the ideas behind modern LLM systems. Read each series in chapter order.</p>
			</header>

			<nav class="series-grid" aria-label="Concept books">
				{series.map((item) => (
					<a href={item.hubPath} class="series-card">
						<span class="card-kind">Book</span>
						<h2>{item.title}</h2>
						{item.description && <p class="series-description">{item.description}</p>}
						<p class="series-meta">{noteLabel(item.articles.length)} →</p>
					</a>
				))}
				{standalone.map((entry) => (
					<a href={getConceptPath(entry.id)} class="series-card">
						<span class="card-kind">Topic</span>
						<h2>{entry.data.title}</h2>
						{entry.data.description && <p class="series-description">{entry.data.description}</p>}
						<p class="series-meta">Open →</p>
					</a>
				))}
			</nav>
		</main>
		<Footer />
	</body>
</html>

<style>
	main.concepts-index {
		width: 58rem;
		max-width: calc(100% - 2em);
	}

	.page-intro {
		margin-bottom: 2rem;
	}

	.page-intro p {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 1.05rem;
	}

	.series-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.25rem;
	}

	.series-card {
		display: flex;
		flex-direction: column;
		padding: 1.35rem 1.4rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		text-decoration: none;
		color: inherit;
		min-height: 11rem;
		transition:
			box-shadow 0.2s,
			border-color 0.2s;
	}

	.series-card:hover {
		border-color: var(--accent);
		box-shadow: var(--box-shadow);
	}

	.card-kind {
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: rgb(var(--gray));
		margin-bottom: 0.45rem;
	}

	.series-card h2 {
		font-size: 1.25rem;
		margin: 0 0 0.4rem;
	}

	.series-description {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 0.95rem;
		line-height: 1.45;
		flex: 1;
	}

	.series-meta {
		margin: 1rem 0 0;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--accent);
	}

	@media (max-width: 720px) {
		.series-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
