---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';
import { getConceptPath, groupConceptsBySeries } from '../../lib/concepts';

const concepts = await getCollection('concepts');
const { series, standalone } = groupConceptsBySeries(concepts);

function noteLabel(count: number): string {
	return count === 1 ? '1 note' : `${count} notes`;
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Concepts - ${SITE_TITLE}`} description="Core ideas and mental models" />
	</head>
	<body>
		<Header />
		<main class="concepts-index">
			<header class="page-intro">
				<h1>Concepts</h1>
				<p>Core ideas and mental models, organized into learning paths.</p>
			</header>

			<nav class="series-grid" aria-label="Concept series">
				{series.map((item) => (
					<a href={item.hubPath} class="series-card">
						<h2>{item.title}</h2>
						{item.description && <p class="series-description">{item.description}</p>}
						<p class="series-meta">{noteLabel(item.articles.length)} →</p>
					</a>
				))}
			</nav>

			{standalone.length > 0 && (
				<section class="standalone">
					<h2>Other topics</h2>
					<ul class="article-list">
						{standalone.map((entry) => (
							<li>
								<a href={getConceptPath(entry.id)}>{entry.data.title}</a>
								{entry.data.description && <p>{entry.data.description}</p>}
							</li>
						))}
					</ul>
				</section>
			)}
		</main>
		<Footer />
	</body>
</html>

<style>
	main.concepts-index {
		width: 58rem;
		max-width: calc(100% - 2em);
	}

	.page-intro {
		margin-bottom: 2rem;
	}

	.page-intro p {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 1.05rem;
	}

	.series-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1.25rem;
	}

	.series-card {
		display: flex;
		flex-direction: column;
		padding: 1.35rem 1.4rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		text-decoration: none;
		color: inherit;
		transition:
			box-shadow 0.2s,
			border-color 0.2s;
	}

	.series-card:hover {
		border-color: var(--accent);
		box-shadow: var(--box-shadow);
	}

	.series-card h2 {
		font-size: 1.25rem;
		margin: 0 0 0.4rem;
	}

	.series-description {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 0.95rem;
		line-height: 1.45;
		flex: 1;
	}

	.series-meta {
		margin: 1rem 0 0;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--accent);
	}

	.standalone {
		margin-top: 2.5rem;
	}

	.standalone h2 {
		font-size: 1.15rem;
		margin-bottom: 0.85rem;
	}

	.article-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.article-list li {
		margin-bottom: 1rem;
	}

	.article-list a {
		font-weight: 600;
		text-decoration: none;
	}

	.article-list a:hover {
		color: var(--accent);
	}

	.article-list p {
		margin: 0.2rem 0 0;
		color: rgb(var(--gray));
		font-size: 0.95rem;
	}
</style>
