---
import { getCollection, render } from 'astro:content';
import Layout from '../../../components/inference-v2/Layout.astro';
import { collectionIdToSlug, NAV_PAGES, INFERENCE_V2_BASE } from '../../../lib/inference-v2';

export async function getStaticPaths() {
 const entries = await getCollection('inferenceV2');
 const byId = new Map(entries.map(entry => [collectionIdToSlug(entry.id), entry]));
 return NAV_PAGES.filter(page => page.slug !== '').map(page => ({
  params: { slug: page.slug }, props: { page, entry: byId.get(page.slug) ?? null },
 }));
}
const { page, entry } = Astro.props;
// Keep old links working without maintaining extra indexes or empty sections.
if (!entry) return Astro.redirect(INFERENCE_V2_BASE + '/', 301);
const { Content } = await render(entry);
---
<Layout title={page.title} description={page.description} slug={page.slug}>
 <Content />
</Layout>
