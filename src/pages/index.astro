---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const sections = [
	{
		title: 'Concepts',
		href: '/concepts',
		description: 'Core ideas and mental models',
	},
	{
		title: 'Build from Scratch',
		href: '/build-from-scratch',
		description: 'Implementing things from the ground up',
	},
	{
		title: 'Projects',
		href: '/projects',
		description: 'End-to-end project walkthroughs',
	},
	{
		title: 'Explore',
		href: '/explore',
		description: 'Experiments and open-ended investigations',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>{SITE_TITLE}</h1>
				<p>{SITE_DESCRIPTION}</p>
			</section>
			<nav class="sections">
				{sections.map((section) => (
					<a href={section.href} class="section-card">
						<h2>{section.title}</h2>
						<p>{section.description}</p>
					</a>
				))}
			</nav>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		text-align: center;
		margin-bottom: 3rem;
	}
	.hero h1 {
		font-size: 2.5rem;
		margin-bottom: 0.5rem;
	}
	.hero p {
		color: rgb(var(--gray));
		font-size: 1.2rem;
	}
	.sections {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.5rem;
	}
	.section-card {
		display: block;
		padding: 1.5rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		text-decoration: none;
		color: inherit;
		transition: box-shadow 0.2s, border-color 0.2s;
	}
	.section-card:hover {
		border-color: var(--accent);
		box-shadow: var(--box-shadow);
	}
	.section-card h2 {
		font-size: 1.4rem;
		margin-bottom: 0.4rem;
	}
	.section-card p {
		color: rgb(var(--gray));
		margin: 0;
		font-size: 0.95rem;
	}
</style>
