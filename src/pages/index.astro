---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
const notes = await getCollection('concepts');
const readings = [
 {n:'01',tag:'SYSTEMS & PERFORMANCE',title:'Inference engineering',description:'From the transformer forward pass to GPU memory, KV caches, and production serving. An illustrated, interactive book for understanding what makes LLMs fast.',href:'/concepts/llm-inference-v2',kind:'Open the interactive book',visual:'inference'},
 {n:'02',tag:'MODELS & MATHEMATICS',title:'Inside the transformer',description:'Attention, embeddings, positional encoding, and the architecture behind modern language models. Shapes and equations included.',href:'/concepts/transformers',kind:'Explore the series',visual:'transformer'},
 {n:'03',tag:'CODE & FIRST PRINCIPLES',title:'Build it. Understand it.',description:'Implement GPT and an encoder–decoder transformer in PyTorch. Follow the tensors from tokenization to training.',href:'/build-from-scratch',kind:'Open the implementations',visual:'code'}
];
---
<!doctype html>
<html lang="en">
<head>
<BaseHead title="Rangaraj P — AI Engineering, From First Principles to Real Systems" description="Technical manager and AI engineer at Mercedes-Benz. Exploring LLM inference, building transformers from scratch, and turning research into engineering systems." />
</head>
<body class="portfolio">
<Header />
<main id="main-content" data-pagefind-body>
<section class="hero">
<div class="hero-inner">
<div class="hero-copy">
<p class="eyebrow">
<span class="status-dot">
</span> AI ENGINEERING · SYSTEMS · RESEARCH</p>
<h1>From first principles<br/>to <em>real-world</em>
<br/>intelligence<span class="lime">.</span>
</h1>
<p class="intro">I’m Rangaraj. I build AI systems, lead engineering teams, and go deep into how things actually work.</p>
<p class="role">Technical Manager · Mercedes-Benz · Bengaluru, India</p>
<div class="hero-actions">
<a class="button primary" href="#selected-work">Explore my work <span>↘</span>
</a>
<a class="text-link" href="https://github.com/rangarajp">View GitHub ↗</a>
</div>
</div>
<div class="system-art" aria-hidden="true">
<div class="art-top">
<span>ENGINEERING INTELLIGENCE</span>
<span>FIG. 001</span>
</div>
<svg viewBox="0 0 500 430" fill="none">
<defs>
<linearGradient id="lines" x1="80" y1="60" x2="420" y2="400" gradientUnits="userSpaceOnUse">
<stop stop-color="#dcf5aa"/>
<stop offset="1" stop-color="#507c67"/>
</linearGradient>
<radialGradient id="halo">
<stop stop-color="#a7c784" stop-opacity=".13"/>
<stop offset="1" stop-color="#a7c784" stop-opacity="0"/>
</radialGradient>
</defs>
<circle cx="250" cy="210" r="205" fill="url(#halo)"/>
<g stroke="#365448" stroke-width=".6">
<ellipse cx="250" cy="215" rx="212" ry="72" transform="rotate(-30 250 215)"/>
<ellipse cx="250" cy="215" rx="212" ry="72" transform="rotate(30 250 215)"/>
<ellipse cx="250" cy="215" rx="212" ry="72" transform="rotate(90 250 215)"/>
</g>
<g class="network" stroke="url(#lines)" stroke-width="1.1">{Array.from({length:9},(_,i)=>{const a=i*Math.PI*2/9;const x=250+155*Math.cos(a);const y=215+155*Math.sin(a);return <g>
<line x1={x} y1={y} x2="250" y2="215"/>{Array.from({length:4},(_,j)=>{const b=(i+j+2)*Math.PI*2/9;return <line x1={x} y1={y} x2={250+155*Math.cos(b)} y2={215+155*Math.sin(b)} opacity=".4"/>})}<circle cx={x} cy={y} r="5" fill="#112e25"/>
<circle cx={x} cy={y} r="2" fill="#c6e79c"/>
</g>})}<path d="M250 151l56 32v64l-56 32-56-32v-64z" fill="#193e30" stroke="#d6f2ad"/>
<path d="M194 183l56 32 56-32M250 215v64M250 151v64" stroke="#d6f2ad"/>
<circle cx="250" cy="215" r="5" fill="#e0f4b7"/>
</g>
<g fill="#a7bbab" font-family="monospace" font-size="9" letter-spacing="2">
<text x="24" y="100">RESEARCH</text>
<text x="355" y="90">SYSTEMS</text>
<text x="341" y="376">IMPLEMENTATION</text>
</g>
</svg>
<div class="art-bottom">
<span>
<i>
</i> CONNECTING IDEAS TO IMPACT</span>
<span>01 / ∞</span>
</div>
</div>
</div>
<div class="hero-bottom">
<span>THEORY INFORMED. IMPLEMENTATION DRIVEN.</span>
<a href="#selected-work">SCROLL TO EXPLORE ↓</a>
</div>
</section>
<section class="expertise-strip" aria-label="Areas of focus">
<span>MY INTERSECTION</span>
<p>LLM inference</p>
<b>✳</b>
<p>Agentic systems</p>
<b>✳</b>
<p>Applied AI</p>
<b>✳</b>
<p>Engineering leadership</p>
</section>
<section id="selected-work" class="work-section">
<div class="section-top">
<div>
<p class="eyebrow">01 / SELECTED TECHNICAL WORK</p>
<h2>Depth you can <em>explore.</em>
</h2>
</div>
<p>Ideas, derivations, and working code.<br/>The details are the point.</p>
</div>
<div class="work-grid">{readings.map(item=>
<a class={'work-card '+item.visual} href={item.href}>
<div class="card-top">
<span>{item.tag}</span>
<span>{item.n} ↗</span>
</div>
<div class="card-art" aria-hidden="true">{item.visual==='inference'?<div class="bars">{[35,58,45,78,60,96,72,48,30,20].map(h=>
<i style={`--h:${h}%`}/>)}<span>PREFILL → DECODE</span>
</div>:item.visual==='transformer'?<div class="attention">
<span>Q</span>
<i>×</i>
<span>Kᵀ</span>
<i>→</i>
<span>V</span>
<small>Attention is all you need.</small>
</div>:<div class="code-art">
<span class="comment"># build understanding</span>
<br/>
<span>class</span> Transformer(nn.Module):<br/>&nbsp;&nbsp;def forward(self, x):<br/>&nbsp;&nbsp;&nbsp;&nbsp;<span>return</span> self.attention(x)</div>}</div>
<h3>{item.title}</h3>
<p>{item.description}</p>
<span class="card-cta">{item.kind}<span>↗</span>
</span>
</a>)}</div>
</section>
<section class="about-section" id="about">
<div>
<p class="eyebrow">02 / THE ENGINEER BEHIND THE WORK</p>
<h2>Research curiosity.<br/>
<em>Engineering discipline.</em>
</h2>
</div>
<div class="about-copy">
<p>I work at the intersection of AI research and powertrain engineering at Mercedes-Benz, leading Data Aided & Research Engineering.</p>
<p>My interests span agentic platforms, learning systems, and efficient AI. This site is my open engineering notebook: a place to derive the math, write the code, and make the reasoning visible.</p>
<div class="principles">
<span>01 <b>Understand the fundamentals</b>
</span>
<span>02 <b>Build and measure</b>
</span>
<span>03 <b>Make knowledge reusable</b>
</span>
</div>
</div>
</section>
<section class="notebook-section">
<div class="section-top">
<div>
<p class="eyebrow">03 / THE OPEN NOTEBOOK</p>
<h2>Always a little <em>deeper.</em>
</h2>
</div>
<a class="inline-link" href="/concepts">All technical writing ↗</a>
</div>
<div class="note-list">
<a href="/concepts/llm-inference-v2">
<span>01</span>
<h3>What really happens during LLM inference?</h3>
<span>INFERENCE ENGINEERING</span>
<b>↗</b>
</a>
<a href="/concepts/reasoning-models">
<span>02</span>
<h3>How language models learn to reason</h3>
<span>REASONING MODELS</span>
<b>↗</b>
</a>
<a href="/concepts/llm-system-design">
<span>03</span>
<h3>Designing the system around the model</h3>
<span>SYSTEM DESIGN</span>
<b>↗</b>
</a>
</div>
<p class="notebook-foot">{notes.length} technical notes and chapters · Equations, implementations, and lessons along the way.</p>
</section>
<section class="contact-section">
<p class="eyebrow">GOOD SYSTEMS START WITH GOOD CONVERSATIONS.</p>
<h2>Let’s build something<br/>
<em>worth understanding.</em>
</h2>
<a class="button primary" href="https://github.com/rangarajp">Find me on GitHub <span>↗</span>
</a>
<p>AI systems · Applied research · Technical leadership</p>
</section>
</main>
<Footer />
</body>
</html>
<style>

.portfolio {
  background:#f6f5f0;
  color:#233c31
}
.portfolio main {
  width:100%;
  max-width:none;
  padding:0;
  margin:0
}
.eyebrow {
