  margin:auto;
  display:grid;
  grid-template-columns:1.15fr 1fr;
  gap:50px;
  align-items:center
}
.hero .eyebrow {
  color:#c4d3b6;
  display:flex;
  align-items:center;
  gap:10px
}
.status-dot,.art-bottom i {
  width:6px;
  height:6px;
  border-radius:50%;
  background:#cae89b;
  display:inline-block
}
.hero h1 {
  font-size:clamp(48px,5.3vw,82px);
  font-weight:400;
  letter-spacing:-3.5px;
  line-height:1.05;
  color:#f4f4e8;
  margin:0 0 28px
}
